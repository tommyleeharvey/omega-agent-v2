+ cat -n agent/tts_service.py
     1	"""
     2	Chatterbox TTS microservice.
     3	Exposes POST /api/tts { "text": "..." } -> audio/wav bytes,
     4	synthesized in the voice cloned from voice_samples/my_voice.wav.
     5	
     6	Wire this into chat_server.py by importing `tts_bp` and registering it:
     7	    from agent.tts_service import tts_bp
     8	    app.register_blueprint(tts_bp)
     9	
    10	Or call synthesize_speech(text) directly after generating the assistant's
    11	final response text, and stream/save the returned bytes to the client.
    12	"""
    13	import io
    14	import os
    15	from flask import Blueprint, request, send_file, jsonify
    16	
    17	tts_bp = Blueprint("tts", __name__)
    18	
    19	VOICE_SAMPLE_PATH = os.path.join(
    20	    os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
    21	    "voice_samples", "my_voice.wav"
    22	)
    23	
    24	_model = None
    25	
    26	def _get_model():
    27	    global _model
    28	    if _model is None:
    29	        try:
    30	            from chatterbox.tts import ChatterboxTTS
    31	        except ImportError:
    32	            raise RuntimeError(
    33	                "chatterbox-tts is not installed on this backend. "
    34	                "TTS needs a separate host with more build memory — "
    35	                "not this free-tier Render service."
    36	            )
    37	        _model = ChatterboxTTS.from_pretrained(device="cpu")
    38	    return _model
    39	
    40	def synthesize_speech(text: str) -> bytes:
    41	    """Returns WAV audio bytes for the given text, in the cloned voice."""
    42	    if not os.path.exists(VOICE_SAMPLE_PATH):
    43	        raise FileNotFoundError(
    44	            f"No voice sample found at {VOICE_SAMPLE_PATH}. "
    45	            "Record one first (see record_voice_sample.sh)."
    46	        )
    47	    model = _get_model()
    48	    wav = model.generate(text, audio_prompt_path=VOICE_SAMPLE_PATH)
    49	
    50	    buf = io.BytesIO()
    51	    import torchaudio
    52	    torchaudio.save(buf, wav, model.sr, format="wav")
    53	    buf.seek(0)
    54	    return buf.read()
    55	
    56	@tts_bp.route("/api/tts", methods=["POST"])
    57	def tts_endpoint():
    58	    data = request.get_json(force=True) or {}
    59	    text = data.get("text", "").strip()
    60	    if not text:
    61	        return jsonify({"error": "text is required"}), 400
    62	    try:
    63	        audio_bytes = synthesize_speech(text)
    64	    except FileNotFoundError as e:
    65	        return jsonify({"error": str(e)}), 400
    66	    except Exception as e:
    67	        return jsonify({"error": f"TTS failed: {e}"}), 500
    68	
    69	    return send_file(
    70	        io.BytesIO(audio_bytes),
    71	        mimetype="audio/wav",
    72	        as_attachment=False,
    73	        download_name="response.wav",
    74	    )
